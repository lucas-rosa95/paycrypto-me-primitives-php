flowchart TB
    subgraph own["OWN: Semantic boundaries"]
        operation["R01 / R12<br/>Request admission, result and failure meanings"]
        definition["R02<br/>Validated immutable definition data"]
        keypath["R03 / R04 / R06 / R07<br/>Public key, extended key, path and tweak invariants"]
    end
    subgraph compose["COMPOSE: Protocol behavior"]
        bip32["R05: BIP32 CKDpub<br/>Public derivation and metadata transitions"]
        hash160["R08: HASH160<br/>SHA-256 then RIPEMD-160"]
        addresses["R09-R11: Address constructions<br/>P2PKH / P2SH-P2WPKH / P2WPKH<br/>Shared derivation and hashing; distinct terminal semantics"]
    end
    boundary["Semantic adapter / runtime boundary<br/>Bytes and owned outcomes across the boundary<br/>Explicit wiring; vendor objects and errors contained"]
    subgraph delegate["DELEGATE: Runtime / libraries"]
        hashes["D01-D03<br/>SHA-256, RIPEMD-160 and HMAC-SHA512"]
        ecc["D04-D05<br/>Compressed-point validation and serialization<br/>Public scalar tweak mathematics"]
        checked["D06-D07<br/>Bitcoin Base58 / Base58Check"]
        witness["D08-D09<br/>Bech32 / SegWit v0 codec"]
        conversion["D10-D11<br/>Structural decoding and fixed-width conversions"]
    end
    pending["O07: Providers not selected<br/>M03-M04: Conformance and replacement qualification<br/>M05: Joint selection before production wiring"]

    operation --> keypath
