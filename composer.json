{
    "name": "paycrypto-me/primitives",
    "description": "Open, auditable cryptocurrency protocol primitives for PHP.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cryptocurrency",
        "bitcoin",
        "bip32",
        "wallet",
        "primitives"
    ],
    "authors": [
        {
            "name": "PayCrypto.Me",
            "email": "contact@paycrypto.me"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "PayCryptoMe\\Primitives\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PayCryptoMe\\Primitives\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src tests -type f -name '*.php' -print0 | xargs -0 -r -n1 php -l",
        "test": "phpunit --configuration phpunit.xml.dist",
        "analyse": "phpstan analyse --configuration phpstan.neon.dist",
        "check": [
            "@lint",
            "@test",
            "@analyse"
        ],
        "ci": [
            "@composer validate --strict",
            "@composer check-platform-reqs",
            "@check"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
